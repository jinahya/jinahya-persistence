          <version>3.12.0</version>
          <configuration>
            <doclint>all</doclint>
            <links>
              <link>https://docs.oracle.com/en/java/javase/${maven.compiler.release}/docs/api/</link>
              <link>https://jakarta.ee/specifications/platform/11/apidocs/</link>
              <!-- not pinned to ${version.nl.jqno.equalsverifier}: javadoc.io only hosts
                   an element-list for some releases, and a missing one fails the build -->
              <link>https://javadoc.io/doc/nl.jqno.equalsverifier/equalsverifier/latest/</link>
              <!--              <link>https://docs.spring.io/spring-data/jpa/reference/api/java</link>-->
            </links>
            <tags>
              <tag>
                <name>apiNote</name>
                <placement>a</placement>
                <head>API Note:</head>
              </tag>
              <tag>
                <name>implSpec</name>
                <placement>a</placement>
                <head>Implementation Requirements:</head>
              </tag>
              <tag>
                <name>implNote</name>
                <placement>a</placement>
