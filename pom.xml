    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- The BUILD JDK. Main sources target 21 via maven.compiler.release, but the test
                     sources are compiled at release 25, which javac can only do from 25 onwards.
                     A [21,) bound let a JDK 21 build past this rule and fail much later, deep inside
                     testCompile, with "release version 25 not supported". Fail here instead, where the
                     message names the cause. Raise this together with maven.compiler.testRelease,
                     .java-version, and the JDK in .github/workflows/maven.yml. -->
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
        <version>3.16.0</version>
        <configuration>
          <annotationProcessorPaths>
            <!-- follows the selected persistence provider; see the __* profiles -->
            <path>
              <groupId>${metamodel.generator.groupId}</groupId>
              <artifactId>${metamodel.generator.artifactId}</artifactId>
              <version>${metamodel.generator.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${version.org.projectlombok}</version>
            </path>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${version.com.google.errorprone}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${version.com.uber.nullaway}</version>
            </path>
            <!--            &lt;!&ndash; =================================================================================================== &ndash;&gt;-->
            <!--            <path>-->
            <!--              <groupId>com.querydsl</groupId>-->
            <!--              <artifactId>querydsl-apt</artifactId>-->
            <!--              <version>${version.com.querydsl}</version>-->
            <!--              <classifier>jakarta</classifier>-->
            <!--            </path>-->
            <!--            <path>-->
            <!--              <groupId>jakarta.persistence</groupId>-->
            <!--              <artifactId>jakarta.persistence-api</artifactId>-->
            <!--            </path>-->
            <!-- =================================================================================================== -->
          </annotationProcessorPaths>
          <!-- Error Prone + NullAway; see .mvn/jvm.config for the required add-exports/add-opens flags -->
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <!-- the generated JPA static metamodel is not ours to annotate; keep Error Prone off it -->
            <arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/target/generated-sources/.* -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AssertsEnabled=true -Xep:NullAway:${nullaway.severity}</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <!-- Error Prone / NullAway are not run over test sources: tests deliberately pass null. -->
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.self="override"/>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
