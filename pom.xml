        <!-- version.weld: 6.0.3.Final -->
        <!-- version.jakarta.cdi: 4.0.1 -->
        <version.org.jboss.weld>5.0.3.Final</version.org.jboss.weld>
        <version.org.jboss.weld.se>${version.org.jboss.weld}</version.org.jboss.weld.se>
