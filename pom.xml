          <!-- https://central.sonatype.com/artifact/org.hibernate.orm/hibernate-core -->
          <version>${version.org.hibernate.orm}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>__hibernate-orm-7.2-jakarta-ee-11</id>
