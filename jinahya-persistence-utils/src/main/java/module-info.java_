// Not compiled: the trailing underscore keeps this out of the build, as in every other module here. Kept as
// the description of what the module WOULD export, so keep it in step with the packages that exist.
module com.github.jinahya.persistence {

    requires transitive jakarta.persistence;

    exports com.github.jinahya.persistence;
    exports com.github.jinahya.persistence.metamodel;
}
