<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-persistence</artifactId>
    <version>0.5.5-SNAPSHOT</version>
  </parent>

  <artifactId>jinahya-persistence-test-utils</artifactId>

  <name>${project.artifactId}</name>
  <description>Interfaces/classes for testing classes/interfaces created with jinahya-persistence</description>

  <dependencies>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the persistence unit under src/test/resources; the provider itself comes from the __* profiles -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- jakarta.enterprise.context/inject, for the annotations on __PersistenceProducer;
         no <version>: the umbrella BOM decides -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- org.jboss.weld.junit5.*; starts a Weld SE container around the producer -->
    <dependency>
      <groupId>org.jboss.weld</groupId>
      <artifactId>weld-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- lombok.* on test sources only; the processor itself is already on the root pom's
         <annotationProcessorPaths>, which the default-testCompile execution inherits -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- com.navercorp.fixturemonkey.FixtureMonkey, .ArbitraryBuilder, and the api.* introspector/property types -->
    <dependency>
      <groupId>com.navercorp.fixturemonkey</groupId>
      <artifactId>fixture-monkey</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- org.instancio.Instancio, .InstancioObjectApi, .Select, and .settings.Settings -->
    <dependency>
      <groupId>org.instancio</groupId>
      <artifactId>instancio-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- org.jeasy.random.EasyRandom, .EasyRandomParameters, and .FieldPredicates; 6.x is one artifact -->
    <dependency>
      <groupId>org.jeasy</groupId>
      <artifactId>easy-random</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
  </build>
</project>
