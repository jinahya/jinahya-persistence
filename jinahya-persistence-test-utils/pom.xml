<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-persistence</artifactId>
    <version>0.6.3-SNAPSHOT</version>
  </parent>

  <artifactId>jinahya-persistence-test-utils</artifactId>

  <name>${project.artifactId}</name>
  <description>Interfaces/classes for testing classes/interfaces created with jinahya-persistence</description>

  <dependencies>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the persistence unit under src/test/resources; the provider itself comes from the __* profiles -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- com.github.jinahya.object.randomizer.*; the randomizer role EntityPersisterUtils locates, and the three engine
         flavors a consumer extends. Every dependency it declares is 'provided' or 'test', so it brings nothing along -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-object-randomizer</artifactId>
      <scope>compile</scope>
    </dependency>
    <!-- jakarta.enterprise.context/inject, for the annotations on __PersistenceProducer;
         no <version>: the umbrella BOM decides -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- org.jboss.weld.junit5.*; starts a Weld SE container around the producer -->
    <dependency>
      <groupId>org.jboss.weld</groupId>
      <artifactId>weld-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- lombok.* on test sources only; the processor itself is already on the root pom's
         <annotationProcessorPaths>, which the default-testCompile execution inherits -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the engine behind FixtureMonkeyObjectRandomizer -->
    <dependency>
      <groupId>com.navercorp.fixturemonkey</groupId>
      <artifactId>fixture-monkey</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Fixture Monkey keeps its constraint support in a second artifact, which FixtureMonkeyObjectRandomizer
         looks up reflectively: declaring it is what makes that flavor honor jakarta.validation.constraints, which
         PODAM and Instancio do out of their own artifact. Without it the engine fills instances while ignoring every
         constraint, and says so once at DEBUG. The root pom excludes the Jakarta EE 9 stack it declares at compile
         scope; see the <exclusions> there. -->
    <dependency>
      <groupId>com.navercorp.fixturemonkey</groupId>
      <artifactId>fixture-monkey-jakarta-validation</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- what backs the exclusions the root pom applies to fixture-monkey-jakarta-validation: the plugin's
         JakartaArbitraryValidator resolves an implementation by service lookup, and throws when none is present.
         Excluding the Jakarta EE 9 stack it declares is only safe because these two replace it, at the generation
         the umbrella BOM pins. Hibernate Validator needs an expression language implementation of its own. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the engine behind InstancioObjectRandomizer; instancio-core carries its constraint support -->
    <dependency>
      <groupId>org.instancio</groupId>
      <artifactId>instancio-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the engine behind PodamObjectRandomizer; podam carries its constraint support -->
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
  </build>
</project>
