<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="__colorPU">
    <description>Persistence Unit for exercising the color mapped superclasses against an in-memory DB</description>
    <provider>${persistence-unit.provider}</provider>
    <!-- listed explicitly: discovery of unlisted classes is provider-specific in Java SE -->
    <class>com.github.jinahya.persistence.more.color._RgbaEntity</class>
    <class>com.github.jinahya.persistence.more.color._HslEntity</class>
    <class>com.github.jinahya.persistence.more.color._HwbEntity</class>
    <class>com.github.jinahya.persistence.more.color._CmykEntity</class>
    <class>com.github.jinahya.persistence.more.color._PropertyAccessRgbaEntity</class>
    <class>com.github.jinahya.persistence.more.color._OverriddenHslEntity</class>
    <class>com.github.jinahya.persistence.more.converter._ConvertedEntity</class>
    <!-- EclipseLink resolves a @Convert converter against the unit's listed classes; with
         exclude-unlisted-classes it will not find one that is merely referenced. Hibernate does. -->
    <class>com.github.jinahya.persistence.more.converter.__NumberStringAttributeConverters$OfBigDecimal</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <!-- so that the @DecimalMin/@DecimalMax on every component are actually evaluated -->
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- database_to_upper=false keeps the declared column names verbatim, so they can be asserted -->
      <!-- https://github.com/eclipse-ee4j/eclipselink/issues/1393 -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:color;database_to_upper=false;MODE=LEGACY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- eclipselink -->
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <property name="eclipselink.logging.level" value="WARNING"/>
      <!-- hibernate -->
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="__intervalPU">
    <description>Persistence Unit for exercising the interval mapped superclasses against an in-memory DB</description>
    <provider>${persistence-unit.provider}</provider>
    <!-- listed explicitly: discovery of unlisted classes is provider-specific in Java SE -->
    <class>com.github.jinahya.persistence.more.interval._LocalDateIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._LocalTimeIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._LocalDateTimeIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._InstantIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._OffsetDateTimeIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._YearIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._YearMonthIntervalEntity</class>
    <class>com.github.jinahya.persistence.more.interval._DateIntervalEmbeddable</class>
    <class>com.github.jinahya.persistence.more.interval._BookingEntity</class>
    <!-- EclipseLink resolves a @Convert converter against the unit's listed classes; with
         exclude-unlisted-classes it will not find one that is merely referenced. Hibernate does.
         __MappedYearMonthInterval names this one, and without it a YearMonth would be stored as bytes. -->
    <class>com.github.jinahya.persistence.more.converter.__TemporalAccessorStringAttributeConverters$OfYearMonth</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <!-- so that the @AssertTrue invariant on __MappedInterval is actually evaluated -->
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- database_to_upper=false keeps the declared column names verbatim, so they can be asserted -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:interval;database_to_upper=false;MODE=LEGACY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- eclipselink -->
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <property name="eclipselink.logging.level" value="WARNING"/>
      <!-- hibernate -->
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="__rangePU">
    <description>a unit for the range package</description>
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.persistence.more.range._LocalDateRangeEntity</class>
    <class>com.github.jinahya.persistence.more.range._IntegerRangeEntity</class>
    <class>com.github.jinahya.persistence.more.range._PrefixUnsafeStringRangeEntity</class>
    <class>com.github.jinahya.persistence.more.range._DateRangeEmbeddable</class>
    <class>com.github.jinahya.persistence.more.range._ReservationEntity</class>
    <class>com.github.jinahya.persistence.more.range._PropertyAccessRangeEntity</class>
    <!-- EclipseLink resolves a converter only against the unit's listed classes under
         exclude-unlisted-classes it will not find one that is merely referenced. Hibernate does. -->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <!-- so that the @AssertTrue invariant on __MappedRange is actually evaluated -->
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:range;database_to_upper=false;MODE=LEGACY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- eclipselink -->
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <property name="eclipselink.logging.level" value="WARNING"/>
      <!-- hibernate -->
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
