<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <!-- the provider is fixed: this module is EclipseLink's, whichever profile the build runs under -->
  <persistence-unit name="__encryptionEclipseLinkPU">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <!-- the entities only: the named converter needs no listing -->
    <class>com.github.jinahya.persistence.encryption.eclipselink.examples.SecretEntity</class>
    <class>com.github.jinahya.persistence.encryption.eclipselink.examples.AllTypesEntity</class>
    <class>com.github.jinahya.persistence.encryption.eclipselink.examples.MixedEntity</class>
    <class>com.github.jinahya.persistence.encryption.eclipselink.examples.MutableArrayEntity</class>
    <!-- the standard converter MixedEntity uses next to the named one; a JPA converter class has to be listed -->
    <class>com.github.jinahya.persistence.encryption.converter.EncryptedStringConverter</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:encryption-eclipselink;DB_CLOSE_DELAY=-1;database_to_upper=false;MODE=LEGACY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
